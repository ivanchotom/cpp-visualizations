#!/bin/sh
# If the platform still authored as Cursor, rewrite the commit to Ivan.

if [ "${REWRITE_GIT_AUTHOR:-}" = "1" ]; then
  exit 0
fi

gitdir=$(git rev-parse --git-dir)
if [ -d "$gitdir/rebase-merge" ] || [ -d "$gitdir/rebase-apply" ] \
  || [ -f "$gitdir/MERGE_HEAD" ] || [ -f "$gitdir/CHERRY_PICK_HEAD" ]; then
  exit 0
fi

CANON_NAME="Ivan"
CANON_EMAIL="46633666+ivanchotom@users.noreply.github.com"
CANON="$CANON_NAME <$CANON_EMAIL>"

author_email=$(git log -1 --format='%ae')
msg=$(git log -1 --format='%B')

need=0
case "$author_email" in
  cursoragent@cursor.com|*@cursor.com) need=1 ;;
esac
if printf '%s\n' "$msg" | grep -qE '^Co-authored-by:|^Co-Authored-By:|^Made-with:|^Made-With:'; then
  need=1
fi

if [ "$need" -eq 0 ]; then
  exit 0
fi

newmsg=$(printf '%s\n' "$msg" | sed -e '/^Co-authored-by:/d' -e '/^Co-Authored-By:/d' -e '/^Made-with:/d' -e '/^Made-With:/d')

export REWRITE_GIT_AUTHOR=1
export GIT_AUTHOR_NAME="$CANON_NAME"
export GIT_AUTHOR_EMAIL="$CANON_EMAIL"
export GIT_COMMITTER_NAME="$CANON_NAME"
export GIT_COMMITTER_EMAIL="$CANON_EMAIL"

printf '%s\n' "$newmsg" | git commit --amend --no-verify --allow-empty --author="$CANON" -F -
